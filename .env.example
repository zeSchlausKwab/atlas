# Optional overrides. Fresh installs work without an .env file.
# Copy to .env to customize; .env files are ignored by Git.
ATLAS_SERVER_URL=http://127.0.0.1:3100/
ATLAS_CLIENT_URL=http://127.0.0.1:5173/

# For bun run demo (always binds both apps to loopback):
# ATLAS_SERVER_PORT=3100
# ATLAS_CLIENT_PORT=5173
# ATLAS_FILE=data/local-demo.atlas
# ATLAS_DATA_DIR=data/local-demo-state

# To connect only the client to a remote server with bun run dev:
# ATLAS_SERVER_URL=https://maps.example/
