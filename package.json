{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --watch apps/web/server.ts",
    "start": "bun apps/server/index.ts",
    "build:wasm": "wasm-pack build crates/renderer --target web --out-dir ../../packages/renderer/pkg --release && wasm-pack build crates/routing-wasm --target web --out-dir ../../packages/routing/pkg --release",
    "build:web": "bun scripts/build-web.ts",
    "build": "bun run build:wasm && bun run build:web",
    "cli": "bun packages/cli/src/index.ts",
    "data:fetch": "bun run cli fetch",
    "data:build": "bun run cli generate",
    "setup": "bun scripts/setup-local.ts",
    "test": "bun test",
    "test:rust": "cargo test --workspace",
    "typecheck": "tsc --noEmit",
    "data:vienna": "bun scripts/vienna-plus.ts",
    "demo:contextvm": "bun scripts/contextvm-demo.ts",
    "data:danube": "bun scripts/danube-composition.ts",
    "verify:hosted-region": "bun scripts/verify-hosted-region.ts",
    "verify:cached-build": "bun scripts/verify-cached-build.ts",
    "verify:composition": "bun scripts/verify-composition.ts",
    "verify:source-memory": "bun scripts/verify-source-memory.ts",
    "deploy": "bun scripts/deploy.ts",
    "server": "bun run build:host && bun apps/server/index.ts",
    "dev:server": "bun run build:host && bun --watch apps/server/index.ts",
    "client": "bun apps/web/server.ts",
    "build:client": "bun scripts/build-web.ts client",
    "build:host": "bun scripts/build-web.ts host",
    "verify:partitioned-graph": "bun scripts/verify-partitioned-graph.ts",
    "verify:source-store": "bun scripts/verify-source-store.ts",
    "verify:partitioned-build": "bun scripts/verify-partitioned-build.ts",
    "verify:graph-resume": "bun scripts/verify-graph-resume.ts",
    "benchmark:compiler": "bun scripts/benchmark-compiler.ts",
    "verify:source-resume": "bun scripts/verify-source-resume.ts",
    "demo": "bun scripts/local-demo.ts",
    "demo:workspace": "bun scripts/workspace-demo.ts",
    "benchmark:addresses": "bun scripts/benchmark-addresses.ts",
    "verify:workspace-build": "bun scripts/verify-workspace-build.ts",
    "demo:pair": "bun scripts/two-chunk-demo.ts",
    "benchmark:hashtree": "bun scripts/benchmark-hashtree.ts",
    "source:register": "bun scripts/register-source.ts",
    "verify:chat-pair": "bun scripts/verify-chat-pair.ts",
    "verify:spatial-pair": "bun scripts/verify-spatial-pair.ts",
    "verify:continuous-pair": "bun scripts/verify-continuous-pair.ts",
    "verify:recipes-pair": "bun scripts/verify-recipes-pair.ts",
    "map:amend": "bun scripts/amend-map.ts",
    "verify:amendment": "bun scripts/verify-amendment.ts",
    "raster:import": "bun scripts/import-raster.ts",
    "demo:raster": "bun scripts/raster-demo.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@contextvm/sdk": "0.14.3",
    "@hashtree/core": "0.3.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@turf/area": "7.4.0",
    "@turf/bbox-clip": "7.4.0",
    "@turf/boolean-intersects": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/boolean-valid": "7.4.0",
    "@turf/buffer": "7.4.0",
    "@turf/centroid": "7.4.0",
    "@turf/convex": "7.4.0",
    "@turf/difference": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/kinks": "7.4.0",
    "@turf/length": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "@turf/point-on-feature": "7.4.0",
    "@turf/union": "7.4.0",
    "ajv": "8.20.0",
    "d3-contour": "4.0.2",
    "geojson-vt": "4.0.2",
    "maplibre-gl": "6.13.0",
    "nostr-tools": "2.25.2",
    "pngjs": "7.0.0",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/d3-contour": "3.0.6",
    "@types/geojson": "7946.0.16",
    "@types/geojson-vt": "3.2.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
